# Скопируй в .env (файл .env уже в .gitignore) и подставь реальные пути.
# Если переменные не заданы — PipelineConfig использует относительные
# дефолты (data_for_reader_test/input, data_for_reader_test/output,
# data_for_reader_test/meters_table.csv — см. src/gmr/domain/config.py).
# Файл .env автоматически НЕ читается: задайте переменные в окружении
# (PowerShell: $env:GMR_INPUT_DIR="...") или передайте пути в
# `python gmr.py process --input ... --output ... --table ...`.

GMR_INPUT_DIR=D:\gas_photos
GMR_OUTPUT_DIR=D:\gas_photos\processed
GMR_TABLE_PATH=D:\path\to\your_table.csv
