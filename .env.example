# Скопируй в .env (файл .env уже в .gitignore) и подставь реальные пути.
# Если переменные не заданы — reader.PipelineConfig() использует безопасные
# относительные дефолты (data/input, data/output, data/meters_table.csv),
# которых достаточно для запуска golden tests, но не для боевой обработки.

GMR_INPUT_DIR=D:\gas_photos
GMR_OUTPUT_DIR=D:\gas_photos\processed
GMR_TABLE_PATH=D:\path\to\your_table.csv
